# ============================================================================
# OncoPattern — .editorconfig
# ESS KS Life Tech · K-S (Kanishk-Soni)
# ============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json,cff}]
indent_size = 2

# .tech sources are hand-aligned inside declarations and commented tables;
# trimming would rewrite lines that are already deliberate.
[*.tech]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# byte-exact fixtures and rasters: never touched by an editor on save
[*.{vcf,csv,pgm,bmp,ppm,png,tfs,bin,tbc}]
insert_final_newline = false
trim_trailing_whitespace = false
