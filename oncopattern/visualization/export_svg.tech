# ============================================================================
# oncopattern/visualization/export_svg.tech — vector export.
#
# Emits real SVG 1.1: <rect>, <circle>, <line>, <polyline>, <text>.  Heatmaps
# become rect grids, graphs become circle+line collections, timeseries become
# polylines — so the exported figure stays sharp at any zoom and can be edited
# in any vector tool, unlike the raster path.
#
# META @module(name:vis_export_svg, provides:svg_*, requires:vis_renderer)
# ============================================================================

IMPORT oncopattern/visualization/renderer
IMPORT oncopattern/visualization/timeseries
IMPORT oncopattern/data/ingest_csv

DECL svg     : buf<400000> = null
DECL svg_len : int<64> = 0

FUNC svg_begin(w : int<64>, h : int<64>) {
    svg_len = 0
    svg_len = oc_cat(svg, svg_len, strbuf("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"))
    svg_len = oc_cat(svg, svg_len, strbuf("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\""))
    svg_len = oc_cati(svg, svg_len, w)
    svg_len = oc_cat(svg, svg_len, strbuf("\" height=\""))
    svg_len = oc_cati(svg, svg_len, h)
    svg_len = oc_cat(svg, svg_len, strbuf("\" viewBox=\"0 0 "))
    svg_len = oc_cati(svg, svg_len, w)
    svg_len = oc_catb(svg, svg_len, 32)
    svg_len = oc_cati(svg, svg_len, h)
    svg_len = oc_cat(svg, svg_len, strbuf("\">\n"))
    svg_len = oc_cat(svg, svg_len, strbuf("<title>OncoPattern — ESS KS Life Tech</title>\n"))
    svg_len = oc_cat(svg, svg_len, strbuf("<desc>Generated by OncoPattern, K-S (Kanishk-Soni), https://github.com/esskslifetech/OncoPattern</desc>\n"))
    svg_len = oc_cat(svg, svg_len, strbuf("<rect width=\"100%\" height=\"100%\" fill=\"#12161e\"/>\n"))
}

FUNC svg_end() : int<64> {
    svg_len = oc_cat(svg, svg_len, strbuf("</svg>\n"))
    RETURN svg_len
}

# rgb(r,g,b) attribute value
FUNC svg_rgb(r : int<64>, g : int<64>, b : int<64>) {
    svg_len = oc_cat(svg, svg_len, strbuf("rgb("))
    svg_len = oc_cati(svg, svg_len, r)
    svg_len = oc_catb(svg, svg_len, 44)
    svg_len = oc_cati(svg, svg_len, g)
    svg_len = oc_catb(svg, svg_len, 44)
    svg_len = oc_cati(svg, svg_len, b)
    svg_len = oc_catb(svg, svg_len, 41)
}

FUNC svg_rect(x : int<64>, y : int<64>, w : int<64>, h : int<64>, r : int<64>, g : int<64>, b : int<64>) {
    svg_len = oc_cat(svg, svg_len, strbuf("<rect x=\""))
    svg_len = oc_cati(svg, svg_len, x)
    svg_len = oc_cat(svg, svg_len, strbuf("\" y=\""))
    svg_len = oc_cati(svg, svg_len, y)
    svg_len = oc_cat(svg, svg_len, strbuf("\" width=\""))
    svg_len = oc_cati(svg, svg_len, w)
    svg_len = oc_cat(svg, svg_len, strbuf("\" height=\""))
    svg_len = oc_cati(svg, svg_len, h)
    svg_len = oc_cat(svg, svg_len, strbuf("\" fill=\""))
    svg_rgb(r, g, b)
    svg_len = oc_cat(svg, svg_len, strbuf("\"/>\n"))
}

FUNC svg_circle(cx : int<64>, cy : int<64>, rad : int<64>, r : int<64>, g : int<64>, b : int<64>) {
    svg_len = oc_cat(svg, svg_len, strbuf("<circle cx=\""))
    svg_len = oc_cati(svg, svg_len, cx)
    svg_len = oc_cat(svg, svg_len, strbuf("\" cy=\""))
    svg_len = oc_cati(svg, svg_len, cy)
    svg_len = oc_cat(svg, svg_len, strbuf("\" r=\""))
    svg_len = oc_cati(svg, svg_len, rad)
    svg_len = oc_cat(svg, svg_len, strbuf("\" fill=\""))
    svg_rgb(r, g, b)
    svg_len = oc_cat(svg, svg_len, strbuf("\" stroke=\"#e8edf7\" stroke-width=\"1\"/>\n"))
}

FUNC svg_line(x0 : int<64>, y0 : int<64>, x1 : int<64>, y1 : int<64>, r : int<64>, g : int<64>, b : int<64>, wdt : int<64>) {
    svg_len = oc_cat(svg, svg_len, strbuf("<line x1=\""))
    svg_len = oc_cati(svg, svg_len, x0)
    svg_len = oc_cat(svg, svg_len, strbuf("\" y1=\""))
    svg_len = oc_cati(svg, svg_len, y0)
    svg_len = oc_cat(svg, svg_len, strbuf("\" x2=\""))
    svg_len = oc_cati(svg, svg_len, x1)
    svg_len = oc_cat(svg, svg_len, strbuf("\" y2=\""))
    svg_len = oc_cati(svg, svg_len, y1)
    svg_len = oc_cat(svg, svg_len, strbuf("\" stroke=\""))
    svg_rgb(r, g, b)
    svg_len = oc_cat(svg, svg_len, strbuf("\" stroke-width=\""))
    svg_len = oc_cati(svg, svg_len, wdt)
    svg_len = oc_cat(svg, svg_len, strbuf("\"/>\n"))
}

FUNC svg_text(x : int<64>, y : int<64>, s : buf<>, size : int<64>, r : int<64>, g : int<64>, b : int<64>) {
    svg_len = oc_cat(svg, svg_len, strbuf("<text x=\""))
    svg_len = oc_cati(svg, svg_len, x)
    svg_len = oc_cat(svg, svg_len, strbuf("\" y=\""))
    svg_len = oc_cati(svg, svg_len, y)
    svg_len = oc_cat(svg, svg_len, strbuf("\" font-family=\"monospace\" font-size=\""))
    svg_len = oc_cati(svg, svg_len, size)
    svg_len = oc_cat(svg, svg_len, strbuf("\" fill=\""))
    svg_rgb(r, g, b)
    svg_len = oc_cat(svg, svg_len, strbuf("\">"))
    svg_len = oc_cat(svg, svg_len, s)
    svg_len = oc_cat(svg, svg_len, strbuf("</text>\n"))
}

# ---------------------------------------------------------------------------
# composite figures
# ---------------------------------------------------------------------------

# expression heatmap as a rect grid
FUNC svg_heatmap(x : int<64>, y : int<64>, cw : int<64>, ch : int<64>) : int<64> {
    svg_text(x, y - 6, strbuf("GENE EXPRESSION (log2 FPKM+1)"), 11, 225, 230, 240)
    DECL lo : float<64> = 1000000.0
    DECL hi : float<64> = -1000000.0
    DECL i : int<64> = 0
    WHILE i < g_expr_g * g_expr_s {
        IF g_expr[i] < lo {
            lo = g_expr[i]
        }
        IF g_expr[i] > hi {
            hi = g_expr[i]
        }
        i = i + 1
    }
    DECL r : int<64> = 0
    WHILE r < g_expr_g {
        DECL c : int<64> = 0
        WHILE c < g_expr_s {
            ramp((g_expr[r * g_expr_s + c] - lo) / (hi - lo + OC_EPS))
            svg_rect(x + c * cw, y + r * ch, cw - 1, ch - 1, ramp_r, ramp_g, ramp_b)
            c = c + 1
        }
        r = r + 1
    }
    RETURN g_expr_g * g_expr_s
}

# a registered timeseries as a polyline
FUNC svg_polyline(s : int<64>, x : int<64>, y : int<64>, w : int<64>, h : int<64>) : int<64> {
    DECL n : int<64> = ts_len[s]
    IF n < 2 {
        RETURN 0
    }
    ts_autoscale()
    svg_len = oc_cat(svg, svg_len, strbuf("<polyline fill=\"none\" stroke=\""))
    svg_rgb(ts_col_r[s], ts_col_g[s], ts_col_b[s])
    svg_len = oc_cat(svg, svg_len, strbuf("\" stroke-width=\"2\" points=\""))
    DECL i : int<64> = 0
    WHILE i < n {
        DECL px : int<64> = x + (i * w) //// (n - 1)
        DECL t : float<64> = (ts_data[s * 512 + i] - ts_ymin) / (ts_ymax - ts_ymin + OC_EPS)
        DECL py : int<64> = y + h - (t * h) //// 1
        svg_len = oc_cati(svg, svg_len, px)
        svg_len = oc_catb(svg, svg_len, 44)
        svg_len = oc_cati(svg, svg_len, py)
        svg_len = oc_catb(svg, svg_len, 32)
        i = i + 1
    }
    svg_len = oc_cat(svg, svg_len, strbuf("\"/>\n"))
    RETURN n
}

FUNC svg_save(path : buf<>) : int<64> {
    save(path, slice(svg, 0, svg_len))
    RETURN svg_len
}
